# =====================================================================
# TriageLens Environment Configuration Template
# Copy this file to .env and configure your keys.
# NEVER commit .env to version control.
# =====================================================================

# Google Gemini API Configuration (Required for Stage 4 AI Triage)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Threat Intelligence Providers (Optional for Stage 2 Enrichment)
# Note: URLhaus operates keyless by default, or with an optional abuse.ch Auth-Key.
# VT_API_KEY is supported as a backward-compatible alias for VIRUSTOTAL_API_KEY.
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
URLHAUS_API_KEY=your_urlhaus_auth_key_here

# Detection and Confidence Thresholds (WIRE-4)
VIRUSTOTAL_MIN_DETECTIONS=1
ABUSEIPDB_MIN_SCORE=25

# Storage & Backend Configuration
# TRIAGELENS_DB_PATH is supported as an alias for DATABASE_PATH.
DATABASE_PATH=data/triagelens.db
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Analyst Dashboard (Vite Frontend)
VITE_API_BASE_URL=http://localhost:8000
