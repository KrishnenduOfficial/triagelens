# =====================================================================
# TriageLens Environment Configuration Template
# Copy this file to .env and configure your keys.
# NEVER commit .env to version control.
# =====================================================================

# Google Gemini API Configuration (Required for Stage 4 AI Triage)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# Threat Intelligence Providers (Optional for Stage 2 Enrichment)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
URLHAUS_API_KEY=your_urlhaus_api_key_here

# Storage & Backend Configuration
DATABASE_PATH=triagelens.db
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Analyst Dashboard (Vite Frontend)
VITE_API_BASE_URL=http://localhost:8000

