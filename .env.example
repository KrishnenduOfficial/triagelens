# =====================================================================
# TriageLens Environment Configuration Template
# Copy this file to .env and configure your keys.
# NEVER commit .env to version control.
# =====================================================================

# Groq API Configuration (Required for Stage 4 AI Triage)
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Optional; blank means one model only, with no automatic fallback or retries.
GROQ_FALLBACK_MODELS=

# Threat Intelligence Providers (Optional for Stage 2 Enrichment)
# Note: URLhaus operates keyless by default, or with an optional abuse.ch Auth-Key.
# VT_API_KEY is supported as a backward-compatible alias for VIRUSTOTAL_API_KEY.
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
URLHAUS_API_KEY=your_urlhaus_auth_key_here

# Detection and Confidence Thresholds (WIRE-4)
VIRUSTOTAL_MIN_DETECTIONS=1
ABUSEIPDB_MIN_SCORE=25

# Threat Intelligence Rate Limiting & Quotas (WIRE-9)
ENRICHMENT_WAIT_MODE=false
ENRICHMENT_MAX_WAIT_SECONDS=60.0
VIRUSTOTAL_DAILY_QUOTA=500
VIRUSTOTAL_REQUESTS_PER_MINUTE=4
ENRICHMENT_MAX_LOOKUPS_PER_RUN=0

# Storage & Backend Configuration
# TRIAGELENS_DB_PATH is supported as an alias for DATABASE_PATH.
# Relative database paths use the project root, regardless of working directory.
# CLI --db-path overrides only that run; configure the API with the same target.
DATABASE_PATH=data/triagelens.db
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Analyst Dashboard (Vite Frontend)
VITE_API_BASE_URL=http://localhost:8000
