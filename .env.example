# =====================================================================
# TriageLens Environment Configuration Template
# Copy this file to .env and configure your keys.
# NEVER commit .env to version control.
# =====================================================================

# Groq API Configuration (Required for Stage 4 AI Triage)
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Optional; blank means one model only, with no automatic fallback or retries.
GROQ_FALLBACK_MODELS=
# Per-engine rolling-minute pacing; adjust for your account and model.
GROQ_REQUESTS_PER_MINUTE=30
GROQ_TOKENS_PER_MINUTE=8000
GROQ_ESTIMATED_TOKENS_PER_REQUEST=4000
GROQ_MAX_WAIT_SECONDS=60

# Threat Intelligence Providers (Optional for Stage 2 Enrichment)
# Note: URLhaus operates keyless by default, or with an optional abuse.ch Auth-Key.
# VT_API_KEY is supported as a backward-compatible alias for VIRUSTOTAL_API_KEY.
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
URLHAUS_API_KEY=your_urlhaus_auth_key_here

# Detection and Confidence Thresholds (WIRE-4)
VIRUSTOTAL_MIN_DETECTIONS=3
ABUSEIPDB_MIN_SCORE=25

# Threat Intelligence Rate Limiting & Quotas (WIRE-9)
ENRICHMENT_WAIT_MODE=false
ENRICHMENT_MAX_WAIT_SECONDS=60.0
VIRUSTOTAL_DAILY_QUOTA=500
VIRUSTOTAL_REQUESTS_PER_MINUTE=4
# Currently unused by the runtime; use the CLI --max-lookups option for a cap.
# The config parser interprets 0 as no cap.
ENRICHMENT_MAX_LOOKUPS_PER_RUN=0

# Storage & Backend Configuration
DATABASE_BACKEND=sqlite
# TRIAGELENS_DB_PATH is supported as an alias for DATABASE_PATH.
# Relative database paths use the project root, regardless of working directory.
# CLI --db-path overrides only that run; configure the API with the same target.
DATABASE_PATH=data/triagelens.db
# PostgreSQL uses separate process-scoped DSNs. The CLI and evaluation use
# EVALUATOR and TRIAGE. The API uses ANALYST and HUNT. Alembic uses MIGRATION.
# TRIAGELENS_POSTGRES_EVALUATOR_DSN=
# TRIAGELENS_POSTGRES_TRIAGE_DSN=
# TRIAGELENS_POSTGRES_ANALYST_DSN=
# TRIAGELENS_POSTGRES_HUNT_DSN=
# TRIAGELENS_POSTGRES_MIGRATION_DSN=
# Opt-in local Windows YARA roots as a JSON object, e.g. {"samples":"D:\\samples"}.
# No scan directories are registered by default.
YARA_SCAN_ROOTS=
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Analyst Dashboard (Vite Frontend)
VITE_API_BASE_URL=http://localhost:8000

# Compose uses a separate ignored .env.compose file with five distinct passwords.
# See the Compose setup in README.md; never put provider keys in images.
